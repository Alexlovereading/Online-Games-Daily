# REQUIRED — set this to your production domain (no trailing slash) before deploying.
# If unset, this falls back to the value hardcoded in lib/site.ts. Every canonical
# URL, sitemap entry, OG image URL, and JSON-LD "url" field is derived from this.
NEXT_PUBLIC_SITE_URL=https://onlinegamesdaily.com

# Optional — paste the value from Google Search Console → Settings → Ownership verification.
# When set, a <meta name="google-site-verification"> tag is injected on every page.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
